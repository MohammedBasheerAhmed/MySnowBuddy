{
  "manifest_version": 3,
  "name": "NowBuddy",
  "version": "0.8.0",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "description": "Control ServiceNow from your browser: an AI agent with approvals, a smart script editor, access debugger, page X-ray, health scan.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "alarms",
    "offscreen"
  ],
  "host_permissions": [
    "https://*.service-now.com/*",
    "http://127.0.0.1/*",
    "https://api.anthropic.com/*",
    "https://api.openai.com/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.bundle.js"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    },
    "default_title": "NowBuddy - toggle sidebar"
  },
  "commands": {
    "open-palette": {
      "suggested_key": {
        "default": "Ctrl+Shift+Space",
        "mac": "MacCtrl+Shift+Space"
      },
      "description": "Open the NowBuddy command palette"
    },
    "toggle-sidebar": {
      "suggested_key": {
        "default": "Alt+Shift+C",
        "mac": "Alt+Shift+C"
      },
      "description": "Toggle the NowBuddy AI chat sidebar"
    }
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": [
        "https://*.service-now.com/*"
      ],
      "js": [
        "content.bundle.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "content.css",
        "pagebridge.js"
      ],
      "matches": [
        "https://*.service-now.com/*"
      ]
    }
  ],
  "sandbox": {
    "pages": [
      "sandbox.html"
    ]
  }
}
